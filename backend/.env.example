# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Set ONE provider's key. No key at all = rules-only mode (no AI calls).

# --- Azure OpenAI ------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# The deployment name you chose in the Azure portal (not the model name).
AZURE_OPENAI_DEPLOYMENT=
# Optional; defaults to 2024-10-21 (supports JSON-schema structured output).
AZURE_OPENAI_API_VERSION=2024-10-21

# --- OpenAI / Anthropic (alternatives) --------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider (azure | openai | anthropic) and model.
# WIKIPULSE_LLM_PROVIDER=azure
# WIKIPULSE_LLM_MODEL=gpt-5.4-mini

# --- Data source -------------------------------------------------------------
# live = Wikimedia stream, replay = backend/data/sample_events.jsonl
WIKIPULSE_SOURCE=live
WIKIPULSE_REPLAY_SPEED=1

# --- AI cost controls --------------------------------------------------------
# Daily spending limit in US dollars (0 = no dollar limit). Resets 00:00 UTC.
WIKIPULSE_LLM_DAILY_BUDGET_USD=1.00
# Your model's price per 1 million tokens, from the Azure/OpenAI pricing page.
# The defaults are deliberately high, so an unset price over-estimates spend.
WIKIPULSE_LLM_PRICE_INPUT_PER_M=2.50
WIKIPULSE_LLM_PRICE_OUTPUT_PER_M=10.00
WIKIPULSE_LLM_MAX_CALLS_PER_HOUR=60
# The chat assistant has its own hourly allowance (the dollar budget is shared).
WIKIPULSE_LLM_ASSISTANT_CALLS_PER_HOUR=30
WIKIPULSE_LLM_EFFORT=low

# --- Login -------------------------------------------------------------------
# Set a password to require login for the dashboard, API and live socket.
# No password = login off (handy for local development).
WIKIPULSE_AUTH_USERNAME=admin
WIKIPULSE_AUTH_PASSWORD=
# Signs session cookies. Set a long random value so sessions survive restarts
# (python3 -c "import secrets; print(secrets.token_hex(32))"). Empty = random
# per start, which logs everyone out on restart.
WIKIPULSE_SESSION_SECRET=
WIKIPULSE_SESSION_HOURS=12
# true when the site is served over HTTPS
WIKIPULSE_COOKIE_SECURE=false
